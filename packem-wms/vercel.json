{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/wms-data/requests",
      "destination": "/api/requisicoes"
    },
    {
      "source": "/wms-data/request-update",
      "destination": "/api/req-baixa"
    },
    {
      "source": "/wms-data/assistant",
      "destination": "/api/ask"
    },
    {
      "source": "/wms-data/stock-operation",
      "destination": "/api/stock-operation"
    },
    {
      "source": "/wms-data/fiscal-sync",
      "destination": "/api/fiscal-sync"
    }
  ]
}
