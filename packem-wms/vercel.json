{
  "rewrites": [
    {
      "source": "/wms-data/requests",
      "destination": "/api/requisicoes"
    },
    {
      "source": "/wms-data/request-update",
      "destination": "/api/req-baixa"
    },
    {
      "source": "/wms-data/assistant",
      "destination": "/api/ask"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/wms-data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
